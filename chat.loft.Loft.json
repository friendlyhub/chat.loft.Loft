{
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "24.08",
  "build-options": {
    "append-path": "/usr/lib/sdk/node22/bin",
    "env": {
      "npm_config_nodedir": "/usr/lib/sdk/node22"
    }
  },
  "command": "loft",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=all",
    "--share=network",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.kde.KWin",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gnome.Shell.Extensions",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--own-name=chat.loft.*",
    "--filesystem=xdg-config/autostart:create",
    "--filesystem=xdg-data/applications:create"
  ],
  "id": "chat.loft.Loft",
  "modules": [
    {
      "build-commands": [
        "npm ci --offline",
        "node node_modules/electron/install.js",
        "npm run build",
        "mkdir -p /app/main",
        "cp -r dist package.json node_modules /app/main/",
        "install -Dm755 flatpak/loft-launcher.sh /app/bin/loft",
        "install -Dm644 data/chat.loft.Loft.desktop /app/share/applications/chat.loft.Loft.desktop",
        "install -Dm644 data/chat.loft.Loft.metainfo.xml /app/share/metainfo/chat.loft.Loft.metainfo.xml",
        "install -Dm644 build/icon.png /app/share/icons/hicolor/512x512/apps/chat.loft.Loft.png"
      ],
      "build-options": {
        "env": {
          "XDG_CACHE_HOME": "/run/build/loft/flatpak-node/cache",
          "npm_config_cache": "/run/build/loft/flatpak-node/npm-cache",
          "npm_config_offline": "true"
        }
      },
      "buildsystem": "simple",
      "name": "loft",
      "sources": [
        {
          "path": ".",
          "skip": [
            ".git",
            "build-dir",
            ".flatpak-repo",
            "target",
            "node_modules",
            "dist",
            "dist-electron"
          ],
          "type": "dir"
        },
        "generated-sources.json",
        {
          "path": "chat.loft.Loft.metainfo.xml",
          "type": "file"
        }
      ]
    }
  ],
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node22"
  ]
}